{
  "info": {
    "name": "Ticket Booking API",
    "description": "Movie Ticket Booking System. One folder per module/phase; extended as phases land.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Phase 0 - Common",
      "item": [
        {
          "name": "Ping (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/ping", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ping"] }
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "Protected probe (expect 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/secure-probe", "host": ["{{baseUrl}}"], "path": ["api", "v1", "secure-probe"] }
          }
        }
      ]
    },
    {
      "name": "Phase 1 - Auth",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"9998887776\",\n  \"password\": \"Secret123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login (saves accessToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"Secret123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Login as seeded admin (saves accessToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@moviebooking.com\",\n  \"password\": \"Admin@12345\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Current user (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Phase 2 - Catalog (Admin)",
      "description": "Log in as the seeded admin first (Phase 1) to populate {{accessToken}}.",
      "item": [
        {
          "name": "Create city",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bengaluru\",\n  \"state\": \"Karnataka\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/cities", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "cities"] }
          }
        },
        {
          "name": "Create theatre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cityId\": 1,\n  \"name\": \"PVR Forum\",\n  \"address\": \"Koramangala\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/theatres", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "theatres"] }
          }
        },
        {
          "name": "Create screen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"theatreId\": 1,\n  \"name\": \"Screen 1\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/screens", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "screens"] }
          }
        },
        {
          "name": "Add seats (row blocks)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rows\": [\n    {\"rowLabel\": \"A\", \"seatType\": \"RECLINER\", \"count\": 8},\n    {\"rowLabel\": \"B\", \"seatType\": \"PREMIUM\", \"count\": 12},\n    {\"rowLabel\": \"C\", \"seatType\": \"REGULAR\", \"count\": 20}\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/screens/1/seats", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "screens", "1", "seats"] }
          }
        },
        {
          "name": "List screen seats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/screens/1/seats", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "screens", "1", "seats"] }
          }
        },
        {
          "name": "Create movie",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Inception\",\n  \"language\": \"English\",\n  \"genre\": \"SciFi\",\n  \"durationMin\": 148,\n  \"certificate\": \"UA\",\n  \"releaseDate\": \"2010-07-16\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/movies", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "movies"] }
          }
        }
      ]
    },
    {
      "name": "Phase 2 - Catalog (Public)",
      "item": [
        {
          "name": "List cities",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/cities", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cities"] }
          }
        },
        {
          "name": "Browse movies (title search)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/movies?q=inc", "host": ["{{baseUrl}}"], "path": ["api", "v1", "movies"], "query": [{ "key": "q", "value": "inc" }] }
          }
        }
      ]
    },
    {
      "name": "Phase 3 - Refund Policies",
      "description": "Log in as the seeded admin first to populate {{accessToken}}.",
      "item": [
        {
          "name": "Create refund policy",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Standard\",\n  \"rules\": [\n    {\"minMinutesBeforeShow\": 1440, \"refundPercent\": 100},\n    {\"minMinutesBeforeShow\": 120, \"refundPercent\": 50},\n    {\"minMinutesBeforeShow\": 30, \"refundPercent\": 0}\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/refund-policies", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "refund-policies"] }
          }
        },
        {
          "name": "Update refund policy (replace rules)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Standard\",\n  \"active\": true,\n  \"rules\": [\n    {\"minMinutesBeforeShow\": 1440, \"refundPercent\": 80},\n    {\"minMinutesBeforeShow\": 60, \"refundPercent\": 25}\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/refund-policies/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "refund-policies", "1"] }
          }
        },
        {
          "name": "List refund policies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/refund-policies", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "refund-policies"] }
          }
        },
        {
          "name": "Get refund policy",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/refund-policies/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "refund-policies", "1"] }
          }
        }
      ]
    },
    {
      "name": "Phase 4 - Shows (Admin)",
      "description": "Create the catalog (city/theatre/screen/seats/movie) and a refund policy first; then set startTime to a future ISO-8601 instant and the ids below.",
      "item": [
        {
          "name": "Create show",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"movieId\": 1,\n  \"screenId\": 1,\n  \"startTime\": \"2026-08-01T18:00:00Z\",\n  \"refundPolicyId\": 1,\n  \"prices\": [\n    {\"seatType\": \"RECLINER\", \"price\": 45000},\n    {\"seatType\": \"PREMIUM\", \"price\": 30000},\n    {\"seatType\": \"REGULAR\", \"price\": 20000}\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/shows", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "shows"] }
          }
        },
        {
          "name": "Update show (prices and/or startTime)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"prices\": [\n    {\"seatType\": \"RECLINER\", \"price\": 50000},\n    {\"seatType\": \"PREMIUM\", \"price\": 32000},\n    {\"seatType\": \"REGULAR\", \"price\": 22000}\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/shows/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "shows", "1"] }
          }
        },
        {
          "name": "Cancel show",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/shows/1/cancel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "shows", "1", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Phase 4 - Shows (Public)",
      "item": [
        {
          "name": "Search shows (by city)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/shows?cityId=1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shows"], "query": [{ "key": "cityId", "value": "1" }, { "key": "movieId", "value": "1", "disabled": true }, { "key": "date", "value": "2026-08-01", "disabled": true }] }
          }
        },
        {
          "name": "Show detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/shows/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shows", "1"] }
          }
        },
        {
          "name": "Seat map",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/shows/1/seats", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shows", "1", "seats"] }
          }
        }
      ]
    }
  ]
}
